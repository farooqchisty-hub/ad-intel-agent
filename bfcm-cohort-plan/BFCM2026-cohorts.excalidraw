   "isDeleted": false,
   "boundElements": null,
   "updated": 1791504000000,
   "link": null,
   "locked": false,
   "text": "BFCM2026 = 30% off monthly, 50% off annual: cohorts\n1 to 3 only.\nValid if never paid + Shopify or WooCommerce store,\n2 to 30 Nov, 11:59 pm PT.\nCohort 4 never gets it: upgrade, cross-sell and\nannual-switch offers instead.",
   "originalText": "BFCM2026 = 30% off monthly, 50% off annual: cohorts\n1 to 3 only.\nValid if never paid + Shopify or WooCommerce store,\n2 to 30 Nov, 11:59 pm PT.\nCohort 4 never gets it: upgrade, cross-sell and\nannual-switch offers instead.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
